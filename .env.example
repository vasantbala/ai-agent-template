# ── Tenant ────────────────────────────────────────────────────────────────────
TENANT_ID=local-dev
ENVIRONMENT=development

# ── LLM Provider ──────────────────────────────────────────────────────────────
# provider: openai | anthropic | openrouter
LLM__PROVIDER=anthropic
LLM__MODEL=claude-sonnet-4-6
LLM__API_KEY=sk-ant-...

# OpenRouter example (uncomment and set base_url):
# LLM__PROVIDER=openrouter
# LLM__MODEL=anthropic/claude-sonnet-4-6
# LLM__API_KEY=sk-or-...
# LLM__BASE_URL=https://openrouter.ai/api/v1

# OpenAI example:
# LLM__PROVIDER=openai
# LLM__MODEL=gpt-4o
# LLM__API_KEY=sk-...

LLM__MAX_TOKENS=4096
LLM__TEMPERATURE=0.0

# ── Langfuse Observability ─────────────────────────────────────────────────────
LANGFUSE__PUBLIC_KEY=pk-lf-...
LANGFUSE__SECRET_KEY=sk-lf-...
LANGFUSE__HOST=http://localhost:3000  # point to local docker-compose langfuse

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT__NAME=my-agent
AGENT__VERSION=1.0.0
AGENT__PROMPT_VERSION=v1
AGENT__MAX_ITERATIONS=10

# ── Reliability ───────────────────────────────────────────────────────────────
RELIABILITY__MAX_TOKENS_PER_RUN=50000
RELIABILITY__MCP_RETRY_ATTEMPTS=3
RELIABILITY__MCP_RETRY_BASE_DELAY=1.0
RELIABILITY__CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
RELIABILITY__CIRCUIT_BREAKER_RESET_TIMEOUT=60.0
RELIABILITY__CONTEXT_WINDOW_THRESHOLD=6000
RELIABILITY__HITL_ENABLED=false

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING__MODEL=text-embedding-3-small
# EMBEDDING__API_KEY=sk-...   # falls back to LLM__API_KEY when not set
EMBEDDING__DIMENSIONS=1536

# ── Memory ────────────────────────────────────────────────────────────────────
MEMORY__ENABLED=false
MEMORY__SCOPE=user          # session | user | tenant | global
MEMORY__TOP_K=5
MEMORY__QDRANT_URL=http://localhost:6333
# MEMORY__QDRANT_API_KEY=   # only needed for Qdrant Cloud

# ── MCP Servers ───────────────────────────────────────────────────────────────
# JSON array of MCP server configs. Leave empty for no MCP tools.
#
# stdio example (local process):
# MCP_SERVERS='[{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]'
#
# http example (remote server):
# MCP_SERVERS='[{"name":"my-server","transport":"http","url":"http://localhost:8080"}]'
#
MCP_SERVERS=[]
